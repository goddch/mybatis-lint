<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.ChooseMisuseMapper">

    <select id="search" resultType="com.example.model.User">
        SELECT id, name FROM users
        <where>
            <choose>
                <when test="name != null">
                    AND name = #{name}
                </when>
                <otherwise>
                    AND 1 = 1
                </otherwise>
                <otherwise>
                    AND 2 = 2
                </otherwise>
            </choose>
            <otherwise>
                AND 3 = 3
            </otherwise>
        </where>
    </select>

    <select id="searchWhenOutsideChoose" resultType="com.example.model.User">
        SELECT id, name FROM users
        <where>
            <when test="name != null">
                AND name = #{name}
            </when>
        </where>
    </select>

</mapper>
