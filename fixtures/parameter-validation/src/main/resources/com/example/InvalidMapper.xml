<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.InvalidMapper">
  <select id="findWithStatus">
    SELECT * FROM users
    <where>
      <if test="name != null">AND name = #{missing}</if>
      <when test="status != null">AND status = #{status}</when>
    </where>
  </select>
  <select id="findWithMap">
    SELECT * FROM users WHERE name = #{missing}
  </select>
  <select id="findByIds">
    SELECT * FROM users WHERE id IN
    <!--
      Java 側の引数名は "ids" だが、ここでは "missingIds" とタイプミスしている。
      foreach の collection 属性のルート識別子(プロパティパスなら先頭部分)が
      Java Mapper インターフェースの引数・@Param エイリアスのどれとも一致しない
      ため、mybatis-lint/undefined-parameter 診断が出る。
    -->
    <foreach collection="missingIds" item="id" open="(" separator="," close=")">
      #{id}
    </foreach>
  </select>
</mapper>
