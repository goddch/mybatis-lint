<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ValidMapper">
  <select id="findByStatus">
    SELECT * FROM users
    <where>
      <if test="status != null and param2 != null">AND status = #{status}</if>
      <if test="name != null">AND name = #{param1}</if>
    </where>
  </select>
  <select id="findByRequest">
    SELECT * FROM users WHERE id = #{request.userId}
  </select>
  <select id="findByItems">
    <foreach collection="items" item="item" index="idx">#{item}</foreach>
  </select>
  <select id="findByIds">
    SELECT * FROM users WHERE id IN
    <!--
      collection="ids" は Java 側の引数名 "ids" とそのまま一致するため、
      mybatis-lint/undefined-parameter 診断は出ない。
    -->
    <foreach collection="ids" item="id" open="(" separator="," close=")">
      #{id}
    </foreach>
  </select>
  <select id="findByGroups">
    SELECT * FROM users WHERE id IN
    <!--
      collection="request.groups" はプロパティパスなので、ルート識別子である
      "request"(Java 側の引数名)だけを検証し、"groups" が実在するかは見ない。
      さらに、外側の foreach の item="group" は、本アナライザーではステート
      メント全体でフラットに許可されたスコープ変数として扱われるため、
      内側の foreach の collection="group" 参照(ネストした foreach)も
      診断されない。
    -->
    <foreach collection="request.groups" item="group" index="groupIdx" open="(" separator=") OR id IN (" close=")">
      <foreach collection="group" item="id" separator=",">
        #{id}
      </foreach>
    </foreach>
  </select>
  <select id="findByCodes">
    SELECT * FROM users
    <where>
      <if test="status == @com.example.StatusCodes@ACTIVE or status == 'HOLD'">
        AND status = #{status,jdbcType=VARCHAR}
      </if>
      AND code IN
      <foreach collection="codes" item="item" open="(" separator="," close=")">
        #{item,jdbcType=NUMERIC}
      </foreach>
    </where>
  </select>
  <select id="findByModel">
    SELECT * FROM users WHERE id = #{userId}
  </select>
  <select id="findByList">
    SELECT * FROM users WHERE id IN
    <foreach collection="list" item="value" open="(" separator="," close=")">#{value}</foreach>
  </select>
</mapper>
